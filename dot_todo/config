export TODO_DIR="$HOME/Documents/todo-txt"

export TODO_LIST="${TODO_LIST:-todo}"

export TODO_FILE="$TODO_DIR/$TODO_LIST.txt"
export DONE_FILE="$TODO_DIR/$TODO_LIST.done.txt"
export REPORT_FILE="$TODO_DIR/$TODO_LIST.report.txt"

# Default Colored Priorities
export PRI_A=$YELLOW       # Color for D priority
export PRI_B=$GREEN        # Color for D priority
export PRI_C=$LIGHT_BLUE   # Color for D priority

# Additional Colored Priorities
export PRI_D=$LIGHT_PURPLE # Color for D priority
export PRI_E=$LIGHT_CYAN   # Color for E priority
export PRI_F=$LIGHT_RED    # Color for F priority
